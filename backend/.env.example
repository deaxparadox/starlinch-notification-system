# --- Django core (all required — the app fails to start if any of these is missing) ---
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key
DJANGO_ALLOWED_HOSTS=your-app.onrender.com,localhost,127.0.0.1
DJANGO_DEBUG=False

# --- Database (required) ---
# Local docker-compose: postgres://starclinch:localdevpassword@db:5432/starclinch_notifications
# Render: provided automatically for a managed Postgres instance.
DATABASE_URL=postgres://user:password@localhost:5432/starclinch_notifications

# --- CORS (required, comma-separated, no spaces) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# --- JWT / auth (optional — safe defaults shown) ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_NAME=refresh_token
JWT_REFRESH_COOKIE_SECURE=True
JWT_REFRESH_COOKIE_SAMESITE=None

# --- Notification providers (optional — the app runs fine with these unset; a channel just
# fails loudly and logs the failure when a send is attempted without its credentials) ---
# WhatsApp Cloud API (Meta sandbox) — from Meta App Dashboard > WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=your_test_token
PHONE_NUMBER_ID=your_test_phone_number_id
WHATSAPP_API_VERSION=v22.0

# Postmark
POSTMARKAPP_TOKEN=your_server_api_token
POSTMARK_FROM_EMAIL=your_verified_sender@example.com

# OneSignal (Web Push only)
ONESIGNAL_APP_ID=your_onesignal_app_id
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# --- First admin account (optional) ---
# If all three are set, docker-entrypoint.sh creates this superuser on startup (skipped if a user
# with this username already exists). This is the only way to get an admin account on Render's
# free tier, which has no Shell access for `createsuperuser`. Leave unset locally if you're happy
# using the seeded `testadmin` / `testpass123` account from docker-compose instead.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
